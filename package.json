  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "express": ">=4.18.0",
    "fastify": ">=4.0.0",
    "hono": ">=4.0.0",
    "elysia": ">=1.0.0",
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "fastify": { "optional": true },
    "hono": { "optional": true },
    "elysia": { "optional": true },
    "next": { "optional": true }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "elysia": "^1.0.0",
    "eslint": "^8.57.0",
    "express": "^4.19.0",
    "fastify": "^4.26.0",
    "hono": "^4.4.0",
    "next": "^14.2.0",
    "prettier": "^3.2.0",
    "size-limit": "^11.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
