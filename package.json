{
  "name": "@paysuite/webhook-toolkit",
  "version": "0.1.0",
  "description": "Universal, edge-first TypeScript toolkit for receiving, verifying, and routing webhooks from 20+ providers (Stripe, GitHub, Shopify, Clerk, Slack, Twilio, Svix/Standard Webhooks, ...). Zero runtime dependencies, tree-shakeable provider plugins, framework adapters for Express/Fastify/Hono/Elysia/Next.js, pluggable idempotency.",
  "type": "module",
  "license": "MIT",
  "author": "Mykhailo Kryvytskyi",
  "homepage": "https://github.com/j09822475-dev/paysuite-webhook-toolkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j09822475-dev/paysuite-webhook-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/j09822475-dev/paysuite-webhook-toolkit/issues"
  },
  "keywords": [
    "webhook",
    "webhooks",
    "webhook-handler",
    "webhook-verification",
    "signature-verification",
    "stripe-webhook",
    "github-webhook",
    "shopify-webhook",
    "standard-webhooks",
    "svix",
    "hmac",
    "ed25519",
    "idempotency",
    "edge-runtime",
    "cloudflare-workers",
    "vercel-edge",
    "typescript",
    "hono",
    "elysia",
    "nextjs",
    "fastify",
    "express",
    "bun",
    "deno"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PLAN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
